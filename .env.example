# First admin login (only used while no admin user exists yet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password

# Where the site's data (posts, league, squad, settings, users) and uploads are stored.
# Back this folder up regularly. Defaults to ./data
# DATA_DIR=/var/lib/nassaji/data

# Signs admin login cookies. If unset, a random key is generated once in DATA_DIR.
# SESSION_SECRET=

# Admin cookies are HTTPS-only in production. Set to 1 only while testing on plain HTTP.
# INSECURE_COOKIES=1
